@model QuickSort.ViewModels.SortViewModel

@{
    ViewData["Title"] = "QuickSort";
}

<div class="container mt-5">

    <div class="card shadow p-4">

        <h2 class="mb-4 text-center">
            QuickSort Algorithm
        </h2>

        <form asp-action="Index" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">
                <label asp-for="Numbers" class="form-label">
                    Enter Numbers
                </label>

                <input asp-for="Numbers"
                       class="form-control"
                       placeholder="Example: 5,2,9,1,3" />

                <span asp-validation-for="Numbers"
                      class="text-danger">
                </span>
            </div>

            <div class="mb-3">

                <label asp-for="Algorithm" class="form-label">
                    Algorithm Type
                </label>

                <select asp-for="Algorithm"
                        class="form-select">

                    <option value="recursive">
                        Recursive QuickSort
                    </option>

                    <option value="iterative">
                        Iterative QuickSort
                    </option>

                </select>

            </div>

            <button type="submit"
                    class="btn btn-primary w-100">

                Sort Numbers

            </button>

        </form>

        @if (!string.IsNullOrEmpty(Model.Sorted))
        {
            <div class="alert alert-success mt-4">

                <h5>Sorted Result</h5>

                <p>
                    @Model.Sorted
                </p>

                <hr />

                <p>
                    <strong>Execution Time:</strong>
                    @Model.ElapsedMilliseconds ms
                </p>

            </div>
        }

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger mt-4">

                @Model.ErrorMessage

            </div>
        }

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}